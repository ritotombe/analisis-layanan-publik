# ============================================
# API Keys — Isi saat Anda punya credentials
# ============================================

# Reddit API (gratis, daftar di https://old.reddit.com/prefs/apps/)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=antah-scraper:v1.0 (by /u/YOUR_USERNAME)

# YouTube Data API v3 (gratis, buat di https://console.cloud.google.com/)
YOUTUBE_API_KEY=

# Twitter/X (experimental — sering berubah)
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_EMAIL=

# ============================================
# Konfigurasi Umum
# ============================================
SCRAPE_DELAY_SECONDS=2
SCRAPE_WINDOW_DAYS=365
DATABASE_PATH=data/db.sqlite
OUTPUT_DIR=output
